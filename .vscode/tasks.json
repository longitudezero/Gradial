{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Gradial: check",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/Gradial APP/scripts/check.ps1"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Gradial: run overlay",
      "type": "shell",
      "command": "cargo",
      "args": [
        "run",
        "--package",
        "gradial-app"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Gradial APP"
      },
      "group": "build",
      "problemMatcher": [
        "$rustc"
      ]
    }
  ]
}

