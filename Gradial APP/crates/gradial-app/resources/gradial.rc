#define RT_MANIFEST 24
1 RT_MANIFEST "gradial.exe.manifest"
101 ICON "gradial.ico"

1 VERSIONINFO
 FILEVERSION 0,3,0,1
 PRODUCTVERSION 0,3,0,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Gradial contributors\0"
            VALUE "FileDescription", "Gradial radial launcher\0"
            VALUE "FileVersion", "0.3.0-beta.1\0"
            VALUE "InternalName", "gradial\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 longitudezero\0"
            VALUE "OriginalFilename", "gradial.exe\0"
            VALUE "ProductName", "Gradial\0"
            VALUE "ProductVersion", "0.3.0-beta.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
